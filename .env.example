# Railway
PORT=5179
NODE_ENV=production

# TiDB Cloud / MySQL
# Example: mysql://USER:PASSWORD@HOST:4000/DATABASE?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Cloudflare R2
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Use a public R2 custom domain if prepared.
# Example: https://files.samwon.site
R2_PUBLIC_BASE_URL=

# Optional
MAX_BODY_BYTES=125829120
MAX_PHOTO_BYTES=12582912
DB_CONNECTION_LIMIT=4
# Comma-separated administrator accounts. These accounts bypass signup approval.
# Set at least one address before deploying approval-based signup.
ADMIN_EMAILS=youngjaeyi2018@gmail.com

# NAVER Maps Directions REST API (후보노선 자동 검색)
# Dynamic Map Web client ID와 별도로 서버에서만 사용하며, Secret은 브라우저에 노출하지 않습니다.
NAVER_DIRECTIONS_CLIENT_ID=
NAVER_DIRECTIONS_CLIENT_SECRET=
